{
  "name": "@hzblj/expo-zoom-transition",
  "version": "0.1.0",
  "description": "A push that grows out of the view it was opened from, for Expo Router: UIKit's zoom transition on iOS 18 and Material's container transform on Android, native both ways.",
  "author": "Jan Blazej",
  "license": "MIT",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./expo-module.config.json": "./expo-module.config.json",
    "./package.json": "./package.json"
  },
  "files": [
    "android/build.gradle",
    "android/src/**",
    "build",
    "expo-module.config.json",
    "ios",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "android",
    "container-transform",
    "expo",
    "expo-module",
    "expo-router",
    "hero",
    "ios",
    "navigation",
    "react-native",
    "shared-element",
    "transition",
    "zoom-transition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/expo-zoom-transition.git"
  },
  "bugs": {
    "url": "https://github.com/hzblj/expo-zoom-transition/issues"
  },
  "homepage": "https://github.com/hzblj/expo-zoom-transition#readme",
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "yarn build",
    "release": "changeset publish",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "expo": ">=57",
    "expo-router": ">=57",
    "react": "*",
    "react-native": "*",
    "react-native-screens": ">=4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@hzblj/biome-config": "^0.2.1",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.14",
    "expo": "~57.0.30",
    "expo-router": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-screens": "~4.26.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "yarn@4.18.0"
}
